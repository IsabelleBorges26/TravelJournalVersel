generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model usuarios {
  id         Int      @id @default(autoincrement())
  nome       String
  email      String   @unique
  senha      String
  fotoPerfil String?
  criadoEm   DateTime @default(now())

  viagens viagens[]
}

model viagens {
  id         Int      @id @default(autoincrement())
  titulo     String
  pais       String
  cidade     String
  descricao  String?
  dataInicio DateTime
  dataFim    DateTime
  custo      Float?
  avaliacao  Int?
  status     String   @default("planejada")
  usuarioId  Int

  usuario usuarios @relation(fields: [usuarioId], references: [id])
  fotos   fotos[]
}

model fotos {
  id       Int      @id @default(autoincrement())
  imagem   String
  viagemId Int

  viagem viagens @relation(fields: [viagemId], references: [id], onDelete: Cascade)
}